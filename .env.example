# ── SkillArena environment ──────────────────────────────────────────────
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave MONGODB_URI empty to run in demo mode with the bundled sample data.

# MongoDB Atlas (free M0 cluster): Database → Connect → Drivers → connection string
MONGODB_URI=
# Optional: database name (defaults to the one in the connection string)
MONGODB_DB=skillarena

# Better Auth
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (Google Cloud Console → APIs and services → Credentials → OAuth client ID)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password for the demo accounts created by `npm run seed` (min 8 characters)
DEMO_USER_PASSWORD=

# Phase 10 integrations (all optional; the site falls back gracefully without them)
# Judge0 code execution — leave empty to use clearly labelled demo mode
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
# GitHub token raises the public API rate limit from 60 to 5,000 requests/hour
GITHUB_TOKEN=

# Time zone used for calendar days (streaks, heatmap, daily challenges)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Kolkata

# Optional: lets a scheduler (e.g. Vercel Cron) call GET /api/cron/sync-jobs with
# "Authorization: Bearer <CRON_SECRET>" to import Remotive and Arbeitnow listings.
# Without it, imports run when SkillBridge is visited and is due, or from the admin console.
CRON_SECRET=

# Optional: shown on /privacy as the address for data questions and deletion requests.
CONTACT_EMAIL=

# Code runner: "paiza" uses the free Paiza.io API (no key). Setting JUDGE0_URL above takes priority.
CODE_RUNNER=

# Optional: Adzuna India jobs and internships (free key at https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
